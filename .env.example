# =========================================================
# MeetVerse example environment configuration
# Never place real passwords, secrets or API keys here.
# =========================================================


# ---------------------------------------------------------
# Django
# ---------------------------------------------------------

DJANGO_SECRET_KEY=replace-with-a-secure-secret-key

DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

CSRF_TRUSTED_ORIGINS=

SECURE_SSL_REDIRECT=False

SECURE_HSTS_SECONDS=0

SECURE_HSTS_INCLUDE_SUBDOMAINS=False

SECURE_HSTS_PRELOAD=False


# ---------------------------------------------------------
# Database
# Leave empty locally to use SQLite.
# Add the Neon PostgreSQL URL on Render.
# ---------------------------------------------------------

DATABASE_URL=


# ---------------------------------------------------------
# LiveKit
# ---------------------------------------------------------

LIVEKIT_URL=

LIVEKIT_API_KEY=

LIVEKIT_API_SECRET=


# ---------------------------------------------------------
# Mailjet OTP email
# Local development can use the console backend.
# ---------------------------------------------------------

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

MAILJET_API_KEY=

MAILJET_SECRET_KEY=

DEFAULT_FROM_EMAIL=MeetVerse <noreply@meetverse.local>

SERVER_EMAIL=MeetVerse <noreply@meetverse.local>

EMAIL_TIMEOUT=20


# ---------------------------------------------------------
# Google social login
# ---------------------------------------------------------

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=


# ---------------------------------------------------------
# Facebook social login
# ---------------------------------------------------------

FACEBOOK_CLIENT_ID=

FACEBOOK_CLIENT_SECRET=